{
  "framework": null,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site"
    },
    {
      "source": "/index-:numero(\\d+).html",
      "destination": "/index.html"
    },
    {
      "source": "/index_:numero(\\d+).html",
      "destination": "/index.html"
    }
  ]
}